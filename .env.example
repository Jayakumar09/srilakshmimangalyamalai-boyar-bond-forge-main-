R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Resend — transactional email sender (verified domain: srilakshmimangalyamalai.com)
RESEND_API_KEY=
RESEND_FROM=

# Lovable API key — still used by the AI document pre-screen only
LOVABLE_API_KEY=

# Razorpay online payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

