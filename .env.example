# Copy to .env and fill in values. Never commit .env (gitignored).

# Supabase — required (core auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — required for uploads (photo, govt_id, divorce_doc, payment_proof, jathagam)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Resend — transactional email sender (verified domain: srilakshmimangalyamalai.com)
RESEND_API_KEY=
RESEND_FROM=
# Optional: base URL embedded in Supabase Auth confirmation/recovery email links.
# Defaults to window.location.origin at signup time (works for desktop localhost,
# and for a phone that browses the dev server via the PC's LAN URL).
# For phone testing where links must always point at the dev PC, uncomment and set
# to the PC's LAN URL, e.g. http://192.168.1.6:8080
# VITE_AUTH_REDIRECT_URL= http://192.168.1.6:8080

# Lovable API key — still used by the AI document pre-screen only
LOVABLE_API_KEY=

# Razorpay online payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional / dormant until a cron route exists
# LOVABLE_CRON_SECRET=
# LOVABLE_CRON_SECRET_PREVIOUS=